        "permission_protection": "signature"
      }
    },
    "deeplinks": [
      {
        "scheme": "myapp",
        "host": "internal.example.com",
        "component": "com.example.app.InternalActivity"
      }
    ],
    "findings": [],
    "counter_examples": [
      {
        "entry_kind": "component",
        "failed_judgment": "J1",
        "reason_contains": "signature-level permission"
      }
    ]
  }
}
