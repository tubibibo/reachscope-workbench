<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.app">

    <uses-sdk android:targetSdkVersion="33" />

    <application>
        <activity android:name=".MultiDataActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="myapp" android:host="open.example.com" />
                <data android:scheme="https" android:host="shop.example.com" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="api.example.com" android:pathPattern="/v/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
