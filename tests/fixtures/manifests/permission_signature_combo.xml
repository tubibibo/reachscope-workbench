<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.app">

    <permission
        android:name="com.example.app.PRIV_PERM"
        android:protectionLevel="signature|privileged" />
    <permission
        android:name="com.example.app.NUMERIC_PERM"
        android:protectionLevel="0x2" />

    <uses-sdk android:targetSdkVersion="33" />

    <application>
        <activity
            android:name=".PrivActivity"
            android:exported="true"
            android:permission="com.example.app.PRIV_PERM" />
        <activity
            android:name=".NumericActivity"
            android:exported="true"
            android:permission="com.example.app.NUMERIC_PERM" />
    </application>
</manifest>
